## Database (MySQL 8.0.16+ / MariaDB 10.2.1+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jojohrspace
## Aiven: use verify-ca and paste the downloaded CA certificate here.
## For local MySQL, keep disabled.
DB_SSL_MODE=disabled
DB_SSL_CA=

## Session signing secret. Minimum 32 characters. Generate with:
##   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
## Secret for the contract reminder cron endpoint. Minimum 32 characters.
CRON_SECRET=
## Session lifetime in hours.
SESSION_TTL_HOURS=8

## Field encryption (AES-256-GCM) and blind index (HMAC-SHA256).
## Both values must be base64-encoded 32-byte keys and MUST be different.
## Generate with:
##   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
FIELD_HMAC_KEY=
## Key version written into every ciphertext. Increment after a controlled rotation.
FIELD_KEY_VERSION=1

## Initial Super Admin created by `npm run db:seed` (password min. 16 characters).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

## File storage: local for development; r2 is required on Vercel.
FILE_STORAGE=local
R2_ACCOUNT_ID=
R2_BUCKET_NAME=hrjojo-private
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
## Optional root for copying existing local files to R2.
# LEGACY_STORAGE_ROOT=storage

## Per-instance limits; total connections also depend on the number of Vercel instances.
DB_CONNECTION_LIMIT=2
DB_QUEUE_LIMIT=20
